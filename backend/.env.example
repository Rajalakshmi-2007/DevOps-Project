# Copy this file to ".env" (same folder) and fill in YOUR values. Never share or commit ".env".
# Admin login = the email and password you put here. Only you will know them.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Long random text used to sign logins. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

DATABASE_URL=
CORS_ORIGINS=
